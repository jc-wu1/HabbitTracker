<resources>
    <style name="Theme.Habbit" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#F7F7FC</item>
    </style>
    <style name="Theme.Habbit.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F7F7FC</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Habbit</item>
    </style>
</resources>
